<?xml version="1.0" encoding="utf-8"?>
<!-- Release builds: HTTPS only, and only the device's built-in certificate authorities.
     Debug builds use src/debug/res/xml/network_security_config.xml instead. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
