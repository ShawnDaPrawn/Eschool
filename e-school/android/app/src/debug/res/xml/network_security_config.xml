<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: allow plain HTTP and user-installed certificates so the app
     can talk to a local development server or a debugging proxy. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
