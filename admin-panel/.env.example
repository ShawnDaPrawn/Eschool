APP_NAME=e-School
APP_KEY=
# Optional historical keys during an explicit, controlled application-key rotation.
APP_PREVIOUS_KEYS=
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost
# Host names the panel is also reached on besides APP_URL and its subdomains, comma separated (e.g. myschool.org,10.0.0.5).
TRUSTED_HOSTS=
# Pretoria uses South Africa Standard Time. General Settings can override this.
TIMEZONE=Africa/Johannesburg
DEMO_MODE=false
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=eschool
DB_USERNAME=root
DB_PASSWORD=
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
# Jobs run on a queue worker (php artisan queue:work); sync runs them inside the request.
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120
# Minutes before a mobile-app login token expires (43200 = 30 days)
SANCTUM_EXPIRATION=43200
# Web portal origins that may call the API from a browser, comma separated. Empty: app. and teach. on the
# NavigateEd domain in production (staging- prefixed on a staging- APP_URL), localhost when APP_ENV is local.
CORS_ALLOWED_ORIGINS=
MEMCACHED_HOST=127.0.0.1
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# Transactional mail goes through Amazon SES in af-south-1 (ADR 0004). Set
# MAIL_MAILER=smtp and the MAIL_* server below to use an SMTP server instead.
MAIL_MAILER=ses
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
# Secrets: set them here (on Cloud Run, Secret Manager mounts them as these variables). Each one wins over the
# value saved on its settings page, which then neither shows nor saves it; php artisan secrets:audit-settings --purge
# clears the old rows. MAIL_PASSWORD above works the same way.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RECAPTCHA_SECRET_KEY=
FCM_SERVICE_ACCOUNT_JSON=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# Amazon SES (MAIL_MAILER=ses). Without SES_* keys the AWS_* keys above are used.
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
AWS_SES_REGION=af-south-1
# Optional SES configuration set (publishes delivery, bounce and complaint events).
AWS_SES_CONFIGURATION_SET=
# SNS topic ARNs allowed to post to /webhook/mail/ses, comma separated.
SES_SNS_TOPIC_ARNS=
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
LOGO1=
LOGO2=
FAVICON=
LOGIN_IMAGE=

# Enable after guardian onboarding has been verified for existing families.
LEARNER_APPROVAL_ENFORCED=false
LEARNER_PORTAL_URL=https://app.navigateed.co.za

# Independent live service. Provisioning/release remains an explicit deployment action.
LIVE_UPDATES_ENABLED=false
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_PUBLIC_HOST=localhost
REVERB_PUBLIC_PORT=443
REVERB_PUBLIC_SCHEME=wss
REVERB_ALLOWED_ORIGINS=app.navigateed.co.za,teach.navigateed.co.za,staging-app.navigateed.co.za,staging-teach.navigateed.co.za
REVERB_MAX_CONNECTIONS=1000
