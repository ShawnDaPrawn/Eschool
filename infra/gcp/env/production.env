# Production on Google Cloud, read by infra/gcp/provision.sh. Names and sizes
# only: no secret value ever goes in this file.
#
# Production already exists (Cloud Run navigateed-admin, Cloud SQL
# navigateed-mysql, bucket navigateed-d8c06-admin, the three secrets below).
# Before the first run, compare these values with the live service:
#   gcloud run services describe navigateed-admin --region=africa-south1 \
#     --project=navigateed-d8c06 --format=export
# and correct DB_USER, ADMIN_EMAIL and APP_URL here if they differ
# (engineering/runbooks/environments.md, "First production run").

ENVIRONMENT=production

PROJECT_ID=navigateed-d8c06
REGION=africa-south1
SCHEDULER_LOCATION=africa-south1
FIREBASE_PROJECT_ID=navigateed-d8c06

GITHUB_REPOSITORY=ShawnDaPrawn/Eschool

ARTIFACT_REPOSITORY=navigateed

# Cloud SQL (Q0.4: db-custom-2-7680 with high availability, automated backups,
# 7-day point-in-time recovery). Changing the tier of the running instance
# restarts it: the script does that only with ALLOW_SQL_RESTART=yes.
SQL_INSTANCE=navigateed-mysql
SQL_TIER=db-custom-2-7680
SQL_AVAILABILITY=REGIONAL
# Used only when the instance is created; the live instance keeps its disk.
SQL_STORAGE_GB=20
SQL_BACKUP_START=01:00
SQL_RETAINED_BACKUPS=14
SQL_POINT_IN_TIME_RECOVERY=true
SQL_TRANSACTION_LOG_DAYS=7
DB_NAME=navigateed
DB_USER=navigateed

BUCKET=navigateed-d8c06-admin
# Keeps overwritten and deleted uploads for 30 days (restore.md).
BUCKET_VERSIONING=true

SERVICE_ADMIN=navigateed-admin
SERVICE_WORKER=navigateed-worker
JOB_SCHEDULER=navigateed-scheduler
SCHEDULER_TRIGGER=navigateed-scheduler-every-minute
# One warm instance: no cold start for the first teacher of the morning.
ADMIN_MIN_INSTANCES=1
ADMIN_MAX_INSTANCES=10
ADMIN_CPU=1
ADMIN_MEMORY=1Gi
ADMIN_CONCURRENCY=40
WORKER_MIN_INSTANCES=1
WORKER_MAX_INSTANCES=3
WORKER_CPU=1
WORKER_MEMORY=1Gi
JOB_CPU=1
JOB_MEMORY=1Gi
JOB_TASK_TIMEOUT=1800s

SA_ADMIN=navigateed-admin-run
SA_WORKER=navigateed-worker-run
SA_SCHEDULER_INVOKER=navigateed-scheduler-invoker
SA_DEPLOYER=navigateed-deployer

# Empty keeps the live service's APP_URL (the run.app address today). Set it to
# https://admin.navigateed.co.za once DNS and the load balancer are in place.
APP_URL=
# Empty keeps the live service's ADMIN_EMAIL.
ADMIN_EMAIL=
SANCTUM_STATEFUL_DOMAINS=app.navigateed.co.za,teach.navigateed.co.za
# Empty keeps the cookie name production has today (renaming it signs everyone
# out); staging sets its own so the two never collide (ADR 0003).
SESSION_COOKIE=
LOG_LEVEL=info

# Transactional mail through Amazon SES in Cape Town (Q0.1, ADR 0004). The keys
# come from Secret Manager (navigateed-ses-access-key-id and
# navigateed-ses-secret-access-key) and are mounted on the panel and the worker
# once both have a value. A mail_mailer row saved on the panel's Email
# Configuration page still overrides MAIL_MAILER.
MAIL_MAILER=ses
AWS_SES_REGION=af-south-1
# The SES configuration set that publishes Delivery, Bounce, Complaint and
# Reject events to SNS; created with the AWS account (ADR 0004).
AWS_SES_CONFIGURATION_SET=navigateed-production
# Comma-separated SNS topic ARNs whose messages POST /webhook/mail/ses accepts.
# Empty until the AWS account exists; the webhook then refuses every message.
SES_SNS_TOPIC_ARNS=

# Browser origins allowed to call the API besides the panel (config/cors.php).
# Empty allows the portal hostnames of Q0.2 for this APP_URL, which are:
# https://app.navigateed.co.za,https://teach.navigateed.co.za
CORS_ALLOWED_ORIGINS=
SESSION_SAME_SITE=lax
# The parent domain the panel and the portals (admin., app., teach.)
# share. The session and XSRF-TOKEN cookies are set on it so the portals can
# sign in with the session cookie. provision.sh applies it (and the portal
# SANCTUM_STATEFUL_DOMAINS above) only once APP_URL is under it; until then
# the portals are built with bearer tokens. SESSION_SECURE_COOKIE follows the
# https:// APP_URL.
SESSION_DOMAIN=.navigateed.co.za
# How long a learner's set-up link (e-mailed to a guardian) and printed
# one-time code stay valid, in days (work stream S6).
LEARNER_INVITATION_LINK_DAYS=7
LEARNER_SETUP_CODE_DAYS=30

ERROR_ALERT_THRESHOLD=10
