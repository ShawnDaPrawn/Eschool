# Staging on Google Cloud, read by infra/gcp/provision.sh. Names and sizes
# only: no secret value ever goes in this file. See
# engineering/runbooks/environments.md for what each piece is for.

ENVIRONMENT=staging

# Its own project, so the staging deployer can never touch production. The
# product owner creates it and links billing before the first run.
PROJECT_ID=navigateed-staging
REGION=africa-south1
# Cloud Scheduler only fires the trigger (no data); move it if Cloud Scheduler
# is not offered in africa-south1 for the project.
SCHEDULER_LOCATION=africa-south1
# Firebase Hosting for the staging portals and docs (the project's default site
# serves the docs; FIREBASE_SITE_* in the GitHub environment name the others).
FIREBASE_PROJECT_ID=navigateed-staging

# The repository GitHub Actions deploys from (Workload Identity Federation).
GITHUB_REPOSITORY=ShawnDaPrawn/Eschool

ARTIFACT_REPOSITORY=navigateed

# Cloud SQL (Q0.4: staging db-g1-small, no high availability).
SQL_INSTANCE=navigateed-mysql
SQL_TIER=db-g1-small
SQL_AVAILABILITY=ZONAL
SQL_STORAGE_GB=10
SQL_BACKUP_START=01:00
SQL_RETAINED_BACKUPS=7
SQL_POINT_IN_TIME_RECOVERY=false
SQL_TRANSACTION_LOG_DAYS=7
DB_NAME=navigateed
DB_USER=navigateed

# Uploads (mounted at storage/app). Bucket names are global.
BUCKET=navigateed-staging-admin
BUCKET_VERSIONING=false

# Cloud Run.
SERVICE_ADMIN=navigateed-admin
SERVICE_WORKER=navigateed-worker
JOB_SCHEDULER=navigateed-scheduler
SCHEDULER_TRIGGER=navigateed-scheduler-every-minute
ADMIN_MIN_INSTANCES=0
ADMIN_MAX_INSTANCES=4
ADMIN_CPU=1
ADMIN_MEMORY=1Gi
ADMIN_CONCURRENCY=40
WORKER_MIN_INSTANCES=1
WORKER_MAX_INSTANCES=2
WORKER_CPU=1
WORKER_MEMORY=1Gi
JOB_CPU=1
JOB_MEMORY=1Gi
JOB_TASK_TIMEOUT=1800s

# Service accounts (the part before @PROJECT_ID.iam.gserviceaccount.com).
SA_ADMIN=navigateed-admin-run
SA_WORKER=navigateed-worker-run
SA_SCHEDULER_INVOKER=navigateed-scheduler-invoker
SA_DEPLOYER=navigateed-deployer

# The address people use. Empty until DNS points staging-admin at the service;
# then the run.app address is used, and stays accepted through TRUSTED_HOSTS.
APP_URL=
# The admin the entrypoint provisions on an empty database.
ADMIN_EMAIL=admin@staging.navigateed.co.za
# Portal origins allowed to use the cookie-based (stateful) API.
SANCTUM_STATEFUL_DOMAINS=staging-app.navigateed.co.za,staging-teach.navigateed.co.za
# Must differ from production's: both sit under navigateed.co.za (ADR 0003).
SESSION_COOKIE=navigateed_staging_session
LOG_LEVEL=info

# Transactional mail through Amazon SES in Cape Town (Q0.1, ADR 0004). The keys
# come from Secret Manager (navigateed-ses-access-key-id and
# navigateed-ses-secret-access-key) and are mounted on the panel and the worker
# once both have a value. A mail_mailer row saved on the panel's Email
# Configuration page still overrides MAIL_MAILER.
MAIL_MAILER=ses
AWS_SES_REGION=af-south-1
# The SES configuration set that publishes Delivery, Bounce, Complaint and
# Reject events to SNS; created with the AWS account (ADR 0004).
AWS_SES_CONFIGURATION_SET=navigateed-staging
# Comma-separated SNS topic ARNs whose messages POST /webhook/mail/ses accepts.
# Empty until the AWS account exists; the webhook then refuses every message.
SES_SNS_TOPIC_ARNS=

# SMS and WhatsApp for urgent notices through the one NavigateEd Twilio account
# (Action Plan 2.7). The account SID and auth token come from Secret Manager
# (navigateed-twilio-account-sid, navigateed-twilio-auth-token). Until a sender
# is set here nothing is texted. A messaging service SID (MG...), or an SMS
# sender; the WhatsApp sender (whatsapp:+27...); approved WhatsApp templates.
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_TEMPLATE_NOTICE=
TWILIO_WHATSAPP_TEMPLATE_URGENT_NOTICE=

# Browser origins allowed to call the API besides the panel (config/cors.php).
# Empty allows the portal hostnames of Q0.2 for this APP_URL, which are:
# https://staging-app.navigateed.co.za,https://staging-teach.navigateed.co.za
CORS_ALLOWED_ORIGINS=
SESSION_SAME_SITE=lax
# The parent domain the panel and the portals (staging-admin., staging-app., staging-teach.)
# share. The session and XSRF-TOKEN cookies are set on it so the portals can
# sign in with the session cookie. provision.sh applies it (and the portal
# SANCTUM_STATEFUL_DOMAINS above) only once APP_URL is under it; until then
# the portals are built with bearer tokens. SESSION_SECURE_COOKIE follows the
# https:// APP_URL.
SESSION_DOMAIN=.navigateed.co.za
# How long a learner's set-up link (e-mailed to a guardian) and printed
# one-time code stay valid, in days (work stream S6).
LEARNER_INVITATION_LINK_DAYS=7
LEARNER_SETUP_CODE_DAYS=30

# Monitoring: an error-count alert fires above this many error lines in five
# minutes. ALERT_EMAIL is passed when the script runs, not stored here.
ERROR_ALERT_THRESHOLD=20
