[
  {
    "name": "keep-release-tags",
    "action": {"type": "Keep"},
    "condition": {"tagState": "TAGGED", "tagPrefixes": ["v"]}
  },
  {
    "name": "keep-recent",
    "action": {"type": "Keep"},
    "mostRecentVersions": {"keepCount": 30}
  },
  {
    "name": "delete-old",
    "action": {"type": "Delete"},
    "condition": {"tagState": "ANY", "olderThan": "90d"}
  }
]
